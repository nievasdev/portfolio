---
import WorkDetail from '../../components/WorkDetail.astro';
import { getEntry } from 'astro:content';
import { workPaths } from '../../lib/paths';

export async function getStaticPaths() {
  return workPaths((await getEntry('works', 'en'))?.data ?? []);
}

const { work, others } = Astro.props;
---

<WorkDetail lang="en" work={work} others={others} />
