---
import TransactionsFlow from './TransactionsFlow.astro';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const words = ui[lang].statement.split(' ');
---

<!-- The page's one moment: the claim, then its proof. The words light up one by one as the
     sentence crosses the screen, and the transactions flow below it (CSS only). -->
<section class="band statement">
  <p class="statement-text">
    {words.map((w, i) => (
      <>
        <span class="w" style={`--i:${i}; --n:${words.length}`}>{w}</span>{i < words.length - 1 && ' '}
      </>
    ))}<span class="dot">.</span>
  </p>
  <TransactionsFlow lang={lang} />
</section>
