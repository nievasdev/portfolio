---
import Layout from '../layouts/Layout.astro';
import Hero from './Hero.astro';
import Statement from './Statement.astro';
import Experience from './Experience.astro';
import Projects from './Projects.astro';
import About from './About.astro';
import Contact from './Contact.astro';
import IconSprite from './IconSprite.astro';
import { getEntry } from 'astro:content';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const works = (await getEntry('works', lang))?.data ?? [];
const projects = (await getEntry('projects', lang))?.data ?? [];
---

<Layout lang={lang} path="/" title={t.meta.title} description={t.meta.description} bandFooter>
  <IconSprite />
  <Hero lang={lang} />
  <Statement lang={lang} />
  <Experience lang={lang} works={works} />
  <Projects lang={lang} projects={projects} />
  <About lang={lang} />
  <Contact lang={lang} />
</Layout>
