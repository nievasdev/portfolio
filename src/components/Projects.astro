---
import SearchFlow from './SearchFlow.astro';
import { ui, type Lang } from '../i18n/ui';
import { logoHref, logoStyle } from '../lib/logos';
import type { Project } from '../content/schemas';

interface Props {
  lang: Lang;
  projects: Project[];
}

const { lang, projects } = Astro.props;
const t = ui[lang];
const caseKeys = ['problem', 'role', 'built', 'result'] as const;
// "Uruleyes" → "project-uruleyes": the hero's "try it live" link lands here.
const anchor = (name: string) =>
  'project-' + name.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<section id="projects" class="section" aria-labelledby="h-projects">
  <h2 id="h-projects" class="section-head">{t.sections.projects}<span class="dot">.</span></h2>
  {projects.map((p) => (
    <article class="entry row" id={anchor(p.name)}>
      <div class="meta">
        {p.logo && logoStyle(p.logo) && <svg class="co-mini" style={logoStyle(p.logo)} aria-hidden="true"><use href={logoHref(p.logo)} /></svg>}
        <span>{t.projects.kind[p.kind]}</span>
      </div>
      <div>
        <h3>{p.name}</h3>
        {p.subtitle && <p class="sub">{p.subtitle}</p>}
        {p.text && <p class="body-text">{p.text}</p>}
        {p.diagram === 'search' && <SearchFlow lang={lang} />}
        {p.search && (
          <form class="try" action={p.search.action} method="get" target="_blank" rel="noopener" role="search">
            <label class="try-label" for={`try-${p.name}`}>{t.search.label}</label>
            <div class="try-field">
              <input id={`try-${p.name}`} type="search" name={p.search.param} placeholder={p.search.example} value={p.search.example} autocomplete="off" />
              <button type="submit">{t.search.button} {p.name} →<span class="sr-only"> {t.search.opens}</span></button>
            </div>
          </form>
        )}
        {p.caseStudy && (
          <dl class="pairs">
            {caseKeys.filter((k) => p.caseStudy?.[k]).map((k) => (
              <>
                <dt>{t.projects.case[k]}</dt>
                <dd>{p.caseStudy?.[k]}</dd>
              </>
            ))}
          </dl>
        )}
        {p.screenshots && p.screenshots.length > 0 && (
          <div class:list={['shots', { pair: p.screenshots.length > 1 }]}>
            {p.screenshots.map((s, i) => {
              // Tapping a screenshot enlarges it (Popover API: no JavaScript); Esc or a tap outside closes it.
              // The large copy sits in a closed popover, so the browser only downloads it when opened.
              const id = `${anchor(p.name)}-shot-${i + 1}`;
              return (
                <>
                  <button type="button" class="shot" popovertarget={id}>
                    <span class="sr-only">{t.projects.enlarge}:</span>
                    <img
                      src={`${s.src}-1200.webp`}
                      srcset={`${s.src}-600.webp 600w, ${s.src}-1200.webp 1200w`}
                      sizes={p.screenshots!.length > 1 ? '(max-width: 52rem) 100vw, 23rem' : '(max-width: 52rem) 100vw, 46rem'}
                      width={s.width}
                      height={s.height}
                      alt={s.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                  <dialog id={id} popover class="lightbox">
                    <img src={`${s.src}-1200.webp`} width={s.width} height={s.height} alt={s.alt} loading="lazy" decoding="async" />
                    <div class="lightbox-bar">
                      {p.url && <a href={p.url}>{t.projects.visit}</a>}
                      <button type="button" popovertarget={id} popovertargetaction="hide">{t.projects.close}</button>
                    </div>
                  </dialog>
                </>
              );
            })}
          </div>
        )}
        {p.technologies.length > 0 && (
          <ul class="tags">
            {p.technologies.map((tech) => <li>{tech}</li>)}
          </ul>
        )}
        {(p.url || p.caseStudyUrl) && (
          <div class="links">
            {p.url && <a href={p.url}>{t.projects.visit}</a>}
            {p.caseStudyUrl && <a href={p.caseStudyUrl}>{t.projects.caseStudy}</a>}
          </div>
        )}
      </div>
    </article>
  ))}

</section>
