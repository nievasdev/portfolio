---
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section id="about" class="section" aria-labelledby="h-about">
  <h2 id="h-about" class="section-head">{t.sections.about}<span class="dot">.</span></h2>
  <div class="entry row">
    <span class="meta"></span>
    <div class="prose">
      {t.about.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>
  <div class="entry row">
    <span class="meta">{t.work.stack}</span>
    <dl class="pairs wide">
      {t.about.stack.map((s) => (
        <>
          <dt>{s.label}</dt>
          <dd>{s.items}</dd>
        </>
      ))}
    </dl>
  </div>
</section>
