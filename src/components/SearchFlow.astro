---
// Uruleyes' search pipeline: sources → scraping → PostgreSQL (+ enrichment) → hybrid search API → app.
// Same visual grammar as TransactionsFlow: the gold dots ride one scroll-driven dashed stroke,
// and the opaque boxes cover it, so the dots appear to pass through each stage.
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].searchFlow;

// desktop, viewBox 736x230: five stages in a row, enrichment above PostgreSQL
const wideX = [1, 154, 306, 459, 611];
const W = 124;
// phone, viewBox 340x470: the stages stacked, enrichment beside PostgreSQL
const tallY = [0, 92, 184, 276, 368];
---

<figure class="flow flow-search" role="img" aria-label={t.label}>
  <svg class="flow-wide" viewBox="0 0 736 230" aria-hidden="true">
    <path class="lane dashed" d="M368,64 L368,118" />
    <path class="lane" d="M125,150 L611,150" />
    <path class="tx" d="M125,150 L611,150" style="--lane:0" />
    <rect class="node node-fill" x="306" y="10" width={W} height="54" rx="4" />
    <text x="368" y="33" class="label">{t.enrich[0]}</text>
    <text x="368" y="49" class="label muted">{t.enrich[1]}</text>
    {wideX.map((x, i) => (
      <>
        <rect class="node node-fill" x={x} y="118" width={W} height="64" rx="4" />
        <text x={x + W / 2} y="146" class="label">{t.nodes[i][0]}</text>
        <text x={x + W / 2} y="163" class="label muted">{t.nodes[i][1]}</text>
      </>
    ))}
    <text x={wideX[3] + W / 2} y="208" class="rate">{t.rate}</text>
  </svg>

  <svg class="flow-tall" viewBox="0 0 340 470" aria-hidden="true">
    <path class="lane dashed" d="M200,213 L212,213" />
    <path class="lane" d="M105,58 L105,368" />
    <path class="tx" d="M105,58 L105,368" style="--lane:0" />
    {tallY.map((y, i) => (
      <>
        <rect class="node node-fill" x="10" y={y} width="190" height="58" rx="4" />
        <text x="105" y={y + 26} class="label">{t.nodes[i][0]}</text>
        <text x="105" y={y + 44} class="label muted">{t.nodes[i][1]}</text>
      </>
    ))}
    <rect class="node node-fill" x="212" y="184" width="127" height="58" rx="4" />
    <text x="275" y="210" class="label small">{t.enrich[0]}</text>
    <text x="275" y="228" class="label small muted">{t.enrich[1]}</text>
    <text x="10" y="456" class="rate start">{t.rate}</text>
  </svg>
</figure>
