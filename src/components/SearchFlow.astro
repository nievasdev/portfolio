---
// Uruleyes' search pipeline: sources → scraping → PostgreSQL (+ enrichment) → hybrid search API → app.
// Same visual grammar as TransactionsFlow: the gold dots (the data loading) ride dashed strokes,
// and the opaque boxes cover them, so the dots appear to pass through each stage. Both strokes start
// at scraping, the actor (R-57): one goes to the sources (it fetches the laws), the other on to the
// app; the dots always travel towards a stroke's end.
// A search walks its own path (SEARCH_WALK): app → API → PostgreSQL and back as results. Each stop
// has a gold outline over its stage that lights during that stop, so a stage can light twice.
import { ui, type Lang } from '../i18n/ui';
import { SEARCH_WALK, walkOffsets } from '../lib/search-walk';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].searchFlow;

// desktop, viewBox 736x230: five stages in a row, enrichment above PostgreSQL
const wideX = [1, 154, 306, 459, 611];
const W = 124;
// phone, viewBox 340x330: the stages stacked close, enrichment as two lines beside PostgreSQL
const tallY = [0, 62, 124, 186, 248];
const TALL_H = 44;
// the query pill starts above the first stop and moves by these offsets, one CSS variable per stop
const PILL_W = 84;
const pillX = wideX[SEARCH_WALK[0]] + W / 2;
const pillOffsetVars = walkOffsets(wideX).map((dx, stop) => `--x${stop}:${dx}px`).join(';');
---

<figure class="flow flow-search" role="img" aria-label={t.label}>
  <svg class="flow-wide" viewBox="0 0 736 230" aria-hidden="true">
    <path class="lane dashed" d="M368,64 L368,118" />
    <path class="lane" d="M125,150 L611,150" />
    <path class="tx" d={`M${wideX[1]},150 L${wideX[0] + W},150`} style="--lane:0" />
    <path class="tx" d={`M${wideX[1]},150 L${wideX[4]},150`} style="--lane:0" />
    <rect class="node node-fill" x="306" y="10" width={W} height="54" rx="4" />
    <text x="368" y="33" class="label">{t.enrich[0]}</text>
    <text x="368" y="49" class="label muted">{t.enrich[1]}</text>
    {wideX.map((x, i) => (
      <>
        <rect class="node node-fill stage" x={x} y="118" width={W} height="64" rx="4" />
        <text x={x + W / 2} y="146" class="label">{t.nodes[i][0]}</text>
        <text x={x + W / 2} y="163" class="label muted">{t.nodes[i][1]}</text>
      </>
    ))}
    {SEARCH_WALK.map((stage, stop) => <rect class="stage-lit" style={`--i:${stop}`} x={wideX[stage]} y="118" width={W} height="64" rx="4" />)}
    <text x={wideX[3] + W / 2} y="208" class="rate">{t.rate}</text>
    <!-- a search walking its path: it stops above each stage while that stage lights up -->
    <g class="query" style={pillOffsetVars}>
      <rect class="query-pill" x={pillX - PILL_W / 2} y="88" width={PILL_W} height="20" rx="10" />
      <text class="query-text query-ask" x={pillX} y="102">{t.query}</text>
      <text class="query-text query-results" x={pillX} y="102">{t.results}</text>
    </g>
  </svg>

  <svg class="flow-tall" viewBox="0 0 340 330" aria-hidden="true">
    <path class="lane dashed" d={`M200,${tallY[2] + TALL_H / 2} L214,${tallY[2] + TALL_H / 2}`} />
    <path class="lane" d={`M105,${TALL_H} L105,${tallY[4]}`} />
    <path class="tx" d={`M105,${tallY[1]} L105,${TALL_H}`} style="--lane:0" />
    <path class="tx" d={`M105,${tallY[1]} L105,${tallY[4]}`} style="--lane:0" />
    {tallY.map((y, i) => (
      <>
        <rect class="node node-fill stage" x="10" y={y} width="190" height={TALL_H} rx="4" />
        <text x="105" y={y + 19} class="label">{t.nodes[i][0]}</text>
        <text x="105" y={y + 35} class="label muted">{t.nodes[i][1]}</text>
      </>
    ))}
    {SEARCH_WALK.map((stage, stop) => <rect class="stage-lit" style={`--i:${stop}`} x="10" y={tallY[stage]} width="190" height={TALL_H} rx="4" />)}
    <text x="220" y={tallY[2] + 18} class="label small start">{t.enrich[0]}</text>
    <text x="220" y={tallY[2] + 34} class="label small start muted">{t.enrich[1]}</text>
    <text x="10" y="318" class="rate start">{t.rate}</text>
  </svg>
</figure>
