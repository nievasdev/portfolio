---
import { ui, localePath, type Lang } from '../i18n/ui';
import { rich } from '../lib/rich';
import { timelineSegments } from '../lib/timeline';
import { logoHref, logoSvg } from '../lib/logos';
import type { Work } from '../content/schemas';

interface Props {
  lang: Lang;
  works: Work[];
}

const { lang, works } = Astro.props;
const t = ui[lang];
const timeline = timelineSegments(works);
// The home is for scanning: key points and the main technologies; the rest is on each company page.
const HOME_TECHNOLOGIES = 3;
// Logos come from the shared sprite (/logos.svg), in the timeline and beside each entry.
const logoOf = new Map(works.filter((w) => logoSvg(w.logo)).map((w) => [w.slug, logoHref(w.logo)]));
---

<section id="experience" class="section" aria-labelledby="h-experience">
  <h2 id="h-experience" class="section-head">{t.sections.experience}<span class="dot">.</span></h2>

  <nav class="entry row timeline-row" aria-label={t.timeline.label}>
    <span class="meta">{timeline.startYear} — {t.timeline.now}</span>
    <div class="timeline">
      <ol class="timeline-bar">
        {timeline.segments.map((s) => (
          <li class:list={['seg', { current: s.current }]} style={`left:${s.left}%; width:${s.width}%`}>
            <a href={`#work-${s.slug}`} title={s.name}>
              {logoOf.has(s.slug)
                ? <svg class="seg-logo" aria-hidden="true"><use href={logoOf.get(s.slug)} /></svg>
                : <span class="seg-name" aria-hidden="true">{s.name}</span>}
              <span class="sr-only">{s.name}</span>
            </a>
          </li>
        ))}
      </ol>
      <div class="timeline-years" aria-hidden="true">
        <span>{timeline.startYear}</span><span>{timeline.endYear}</span>
      </div>
    </div>
  </nav>

  {works.map((work) => (
    <article class="entry row" id={`work-${work.slug}`}>
      <div class="meta">
        <span>{work.time}</span>
        {logoOf.has(work.slug) && <svg class="co-mini" aria-hidden="true"><use href={logoOf.get(work.slug)} /></svg>}
      </div>
      <div>
        <h3>
          <a href={localePath(lang, `/work/${work.slug}`)} style={`view-transition-name: work-${work.slug}; view-transition-class: work-name`}>{work.name}<span class="go" aria-hidden="true">→</span></a>
          {work.via && <>{' '}<span class="via">({work.via})</span></>}
        </h3>
        <p class="sub">{work.role}</p>
        <ul class="points">
          {work.keyPoints.map((point) => <li set:html={rich(point)} />)}
        </ul>
        <ul class="tags">
          {work.technologies.slice(0, HOME_TECHNOLOGIES).map((tech) => <li>{tech}</li>)}
        </ul>
      </div>
    </article>
  ))}
</section>
