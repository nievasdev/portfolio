---
import Mark from './Mark.astro';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  band?: boolean;
}

const { lang, band = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={['site-footer', { band }]}>
  <div class="wrap">
    <Mark />
    <span>© {year} Mauro Nievas · {ui[lang].footer}</span>
  </div>
</footer>
