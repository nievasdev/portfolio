---
import Mark from './Mark.astro';
import ProfileLinks from './ProfileLinks.astro';
import { ui, type Lang } from '../i18n/ui';
import { figureParts } from '../lib/figures';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<!-- The same row as every entry: the mark hangs in the left margin against the name, the text
     starts on the reading column (the screen's centre axis). -->
<div class="hero home-hero row">
  <div class="hero-mark"><Mark animated /></div>
  <div class="hero-main">
    <h1 class="hero-name">
      <span class="sr-only">Mauro Nievas</span>
      <span aria-hidden="true">mauro<span class="dot">.</span>nievas</span>
    </h1>
    <!-- each piece stays whole and keeps its « ·», so a wrapped line never starts with the dot -->
    <p class="role">
      {t.hero.role.split(' · ').map((piece, i, pieces) => (
        <>{i > 0 && ' '}<span class="nobr">{piece}{i < pieces.length - 1 && ' ·'}</span></>
      ))}
    </p>
    <p class="lede">{t.hero.lede}</p>
    <ul class="facts">
      {t.hero.facts.map((f) => {
        // A number counts up from 0 (CSS counters) over the real text, which shows when it ends and is
        // what screen readers and browsers without motion get.
        const parts = figureParts(f.value);
        const figure = (
          <b class="fig">
            <span class="fig-text">{f.value}</span>
            {parts && (
              <span class="fig-count" aria-hidden="true">{parts.prefix}<span class="count" style={`--to:${parts.integer}`}></span>{parts.fraction !== undefined && <>{parts.separator}<span class="count" style={`--to:${parts.fraction}`}></span></>}{parts.suffix}</span>
            )}
          </b>
        );
        const body = <>{figure} <span class="fig-label">{f.label}</span></>;
        return <li>{f.href ? <a href={f.href}>{body}</a> : body}</li>;
      })}
    </ul>
    <div class="actions">
      <a class="cta" href="#contact">{t.hero.cta} <span class="pip" aria-hidden="true"></span></a>
      <ProfileLinks lang={lang} />
    </div>
  </div>
</div>
