---
import Mark from './Mark.astro';
import ProfileLinks from './ProfileLinks.astro';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<!-- The same row as every entry: the mark hangs in the left margin against the name, the text
     starts on the reading column (the screen's centre axis). -->
<div class="hero home-hero row">
  <div class="hero-mark"><Mark animated /></div>
  <div class="hero-main">
    <h1 class="hero-name">
      <span class="sr-only">Mauro Nievas</span>
      <span aria-hidden="true">mauro<span class="dot">.</span>nievas</span>
    </h1>
    <!-- each piece stays whole and keeps its « ·», so a wrapped line never starts with the dot -->
    <p class="role">
      {t.hero.role.split(' · ').map((piece, i, pieces) => (
        <>{i > 0 && ' '}<span class="nobr">{piece}{i < pieces.length - 1 && ' ·'}</span></>
      ))}
    </p>
    <p class="lede">{t.hero.lede}</p>
    <ul class="facts">
      {t.hero.facts.map((f) => {
        const body = <><b class="fig">{f.value}</b> <span class="fig-label">{f.label}</span></>;
        return <li>{f.href ? <a href={f.href}>{body}</a> : body}</li>;
      })}
    </ul>
    <div class="actions">
      <a class="cta" href="#contact">{t.hero.cta} <span class="pip" aria-hidden="true"></span></a>
      <ProfileLinks lang={lang} />
    </div>
  </div>
</div>
