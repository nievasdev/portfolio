---
import Mark from './Mark.astro';
import { ui, links, localePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<div class="hero row">
  <Mark animated />
  <div>
    <h1>Mauro Nievas</h1>
    <p class="role">{t.hero.role}</p>
    <p class="lede">{t.hero.lede}</p>
    <ul class="facts">
      {t.hero.facts.map((f) => (
        <li>{f.value && <><b>{f.value}</b> </>}{f.label}</li>
      ))}
    </ul>
    <div class="actions">
      <a class="cta" href="#contact">{t.hero.cta} <span class="pip" aria-hidden="true"></span></a>
      <a href={localePath(lang, '/cv.pdf')} download="Mauro-Nievas-CV.pdf">{t.hero.cv}</a>
      <a href={links.github}>GitHub</a>
      <a href={links.linkedin}>LinkedIn</a>
    </div>
  </div>
</div>
