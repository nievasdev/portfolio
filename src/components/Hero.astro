---
import Mark from './Mark.astro';
import { ui, links, localePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<!-- Two columns: who and what on the reading column, the mark large beside the name. -->
<div class="hero home-hero">
  <div class="hero-main">
    <h1 class="hero-name">
      <span class="sr-only">Mauro Nievas</span>
      <span aria-hidden="true">mauro<span class="dot">.</span>nievas</span>
    </h1>
    <p class="role">{t.hero.role}</p>
    <p class="lede">{t.hero.lede}</p>
    <ul class="facts">
      {t.hero.facts.map((f) => {
        const body = <><b>{f.value}</b> {f.label}</>;
        return <li>{f.href ? <a href={f.href}>{body}</a> : body}</li>;
      })}
    </ul>
    <div class="actions">
      <a class="cta" href="#contact">{t.hero.cta} <span class="pip" aria-hidden="true"></span></a>
      <a href={localePath(lang, '/cv.pdf')} download="Mauro-Nievas-CV.pdf">{t.hero.cv}</a>
      <a href={links.github}>GitHub</a>
      <a href={links.linkedin}>LinkedIn</a>
    </div>
  </div>
  <Mark animated />
</div>
